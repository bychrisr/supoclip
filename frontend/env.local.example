# Copy to .env.local when running Next.js on the host (recommended for fast dev on low-spec machines).
# Start API + DB + worker only: from repo root, `docker compose up -d` (no frontend container).
# Then: cd frontend && bun install && bun run dev
#
# If Postgres is mapped to another host port (e.g. SUPOCLIP_HOST_POSTGRES_PORT=5433), adjust DATABASE_URL.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000

DATABASE_URL=postgresql://supoclip:supoclip_password@127.0.0.1:5432/supoclip

BETTER_AUTH_SECRET=supoclip_dev_secret_change_in_production
BETTER_AUTH_URL=http://localhost:3000
BACKEND_AUTH_SECRET=
